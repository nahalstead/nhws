---
import { getEntry, render } from 'astro:content';

const slug = Astro.params.slug;
const page = slug ? await getEntry('pages', slug) : undefined;
const Content = page ? (await render(page)).Content : undefined;

if (!page) {
  Astro.response.status = 404;
}
---

<main class="pb-16">
  {page && Content ? (
    <>
      <h1>{page.data.title}</h1>
      <Content />
    </>
  ) : (
    <h1>Page not found</h1>
  )}
</main>
