---
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="en">
	<head>
		<Head />
		<title>Nick Cosmo</title>
	</head>
	<body class="dark">
		<Header />
