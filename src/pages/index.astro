---
import Head from '../components/Head.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
---

<html lang="en">
	<head>
		<Head />
	</head>
	<body class="dark">
		<header class="grid grid-cols-8 gap-x-4 m-4">
			<div class="col-span-2 border-b border-b-mist-700 pb-4">
				<h1>NHWS</h1>
			</div>
			<div class="col-span-2 border-b border-b-mist-700 pb-4">
				<nav>
					<Navigation />
				</nav>
			</div>
		</header>
		<main>
			<div class="container grid grid-cols-8 gap-x-4 m-4">
				<div class="col-span-4">
				<h2>Freelance web developer with a focus on improving accessibility.</h2>
				<ul role="list" class="list-inside list-disc">
					<li>CMS specialist since 2008</li>
					<li>Lead developer on 100s of projects</li>
					<li>Digital accessibility specialist</li>
				</ul>
				<p>Recent work has focused on auditing and remediating accessibility issues in CMS-based websites, improving WCAG compliance and overall user experience.</p>
			</div>
		</div>
		</main>
		<Footer />
	</body>
</html>
