---
import { getEntry, render } from 'astro:content';
import Head from '../../components/Head.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';

const slug = Astro.params.slug;
const project = slug ? await getEntry('projects', slug) : undefined;
const Content = project ? (await render(project)).Content : undefined;

if (!project) {
  Astro.response.status = 404;
}
---
<html lang="en">
	<head>
		<Head />
		<title>{project ? project.data.title : 'Project not found'} / NHWS</title>
	</head>
	<body class="dark">
		<header class="grid grid-cols-8 gap-x-4 m-4">
			<div class="col-span-2 border-b border-b-mist-700 pb-4">
				<a href="/"><h1>NHWS</h1></a>
			</div>
			<div class="col-span-2 border-b border-b-mist-700 pb-4">
				<nav>
					<Navigation />
				</nav>
			</div>
		</header>

		<main>
			{project && Content ? (
				<>
					<h1>{project.data.title}</h1>
					<Content />
				</>
			) : (
				<h1>Project not found</h1>
			)}
		</main>
		<Footer />
	</body>
</html>