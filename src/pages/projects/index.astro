---
import { getCollection } from 'astro:content';
import Head from '../../components/Head.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---
<html lang="en">
	<head>
		<Head />
		<title>Projects / Nick Cosmo</title>
	</head>
	<body class="dark">
		<header class="grid grid-cols-8 gap-x-4 m-4">
			<div class="col-span-2 border-b border-b-mist-700 pb-4">
				<a href="/">Nick Cosmo</a>
			</div>
			<div class="col-span-2 border-b border-b-mist-700 pb-4">
				<nav>
					<Navigation />
				</nav>
			</div>
		</header>
		<main class="pb-16">
			<div class="container grid grid-cols-8 gap-x-4 m-4">
				<div class="col-span-4">
					{projects.map((project) => (
						<p>
							<a href={`/projects/${project.id}`}>{project.data.title}</a>
						</p>
					))}			
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
